# ==============================================
# DEV COLLAB - Root Environment Variables Template
# ==============================================

# Backend Port
PORT=5000

# MongoDB Connection URI
MONGO_URI=mongodb://localhost:27017/devcollab

# JWT Secret Key
JWT_SECRET=your_super_secret_jwt_key_devcollab_2026

# Frontend Client URL (for CORS and Socket.io)
CLIENT_URL=http://localhost:5173

# Sandboxed Code Execution Service API (Configurable)
CODE_EXECUTION_API_URL=https://emkc.org/api/v2/piston
CODE_EXECUTION_API_KEY=

# Environment Mode
NODE_ENV=development
